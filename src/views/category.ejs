<%- include('partials/header') %>
<main>
    <% if (category) { %>
        <h1><%= category.name %></h1>
        
        <h2>Service Projects</h2>
        
        <% if (projects && projects.length > 0) { %>
            <ul>
                <% projects.forEach(project => { %>
                    <li>
                        <%= new Date(project.date).toLocaleDateString('en-US', { 
                            weekday: 'long', 
                            year: 'numeric', 
                            month: 'long', 
                            day: 'numeric' 
                        }) %>: 
                        <a href="/project/<%= project.project_id %>"><%= project.title %></a> 
                        (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>No service projects in this category yet.</p>
        <% } %>
    <% } else { %>
        <h1>Category Not Found</h1>
        <p>The category you are looking for does not exist.</p>
    <% } %>
    
    <p><a href="/categories">← Back to All Categories</a></p>
</main>
<%- include('partials/footer') %>
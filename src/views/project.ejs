<%- include('partials/header') %>
<main>
    <% if (project) { %>
        <h1><%= project.title %></h1>
        
        <section class="project-details">
            <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString('en-US', { 
                weekday: 'long', 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
            }) %></p>
            
            <p><strong>Location:</strong> <%= project.location %></p>
            
            <p><strong>Description:</strong> <%= project.description %></p>
            
            <p><strong>Organization:</strong> 
                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>
            </p>
            
            <% if (categories && categories.length > 0) { %>
                <div class="categories">
                    <p><strong>Categories:</strong></p>
                    <ul class="category-tags">
                        <% categories.forEach(category => { %>
                            <li class="category-tag">
                                <a href="/category/<%= category.category_id %>"><%= category.name %></a>
                            </li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>
            
            <% if (user && user.role_name === 'admin') { %>
                <p>
                    <a href="/edit-project/<%= project.project_id %>">Edit Project</a> | 
                    <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
                </p>
            <% } %>
        </section>
    <% } else { %>
        <h1>Project Not Found</h1>
        <p>The service project you are looking for does not exist.</p>
    <% } %>
    
    <p><a href="/projects">← Back to Upcoming Projects</a></p>
</main>
<%- include('partials/footer') %>
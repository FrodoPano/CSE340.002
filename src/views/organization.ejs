<%- include('partials/header') %>
<main>
    <% if (organizationDetails) { %>
        <h1><%= organizationDetails.name %></h1>
        <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">
        <p>Description: <%= organizationDetails.description %></p>
        <p>Contact: <%= organizationDetails.contact_email %></p>

        <h3>Service Projects</h3>
        <% if (projects && projects.length > 0) { %>
            <ul>
                <% projects.forEach(project => { %>
                    <li>
                        <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                        - <%= new Date(project.date).toLocaleDateString('en-US', { 
                            year: 'numeric', 
                            month: 'long', 
                            day: 'numeric' 
                        }) %>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>No service projects for this organization yet.</p>
        <% } %>

        <p><a href="/edit-organization/<%= organizationDetails.organization_id %>">Edit Organization</a></p>
    <% } else { %>
        <h1>Organization Not Found</h1>
        <p>The organization you are looking for does not exist.</p>
    <% } %>
</main>
<%- include('partials/footer') %>
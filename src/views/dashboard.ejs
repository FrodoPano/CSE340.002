<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>
    <p>Role: <%= role %></p>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/users">View All Users</a></p>
    <% } %>

    <h3>My Volunteer Projects</h3>
    <% if (volunteerProjects && volunteerProjects.length > 0) { %>
        <ul>
            <% volunteerProjects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    - <%= new Date(project.date).toLocaleDateString('en-US', { 
                        year: 'numeric', 
                        month: 'long', 
                        day: 'numeric' 
                    }) %>
                    (<%= project.organization_name %>)
                    <form action="/dashboard/remove-volunteer/<%= project.project_id %>" method="POST" style="display: inline;">
                        <button type="submit" class="btn-remove-small">Remove</button>
                    </form>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>You haven't signed up for any volunteer projects yet.</p>
        <p><a href="/projects">Browse projects</a> to find volunteer opportunities!</p>
    <% } %>

</main>

<%- include('partials/footer') %>
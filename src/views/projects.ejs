<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Next Five Service Projects</h2>
    
    <% if (projects && projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <%= new Date(project.date).toLocaleDateString('en-US', { 
                        weekday: 'long', 
                        year: 'numeric', 
                        month: 'long', 
                        day: 'numeric' 
                    }) %>: 
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a> 
                    (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No upcoming service projects at this time.</p>
    <% } %>
    
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/new-project">Add a New Service Project</a></p>
    <% } %>
</main>
<%- include('partials/footer') %>